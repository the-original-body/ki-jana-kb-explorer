{
  // ==============================================================================
  // ki-jana-kb-explorer - Cloudflare Workers Configuration
  // ==============================================================================
  //
  // Zero-Auth Configuration: Public access, no authentication
  //
  // See: https://developers.cloudflare.com/workers/wrangler/configuration/
  // ==============================================================================

  "$schema": "node_modules/wrangler/config-schema.json",

  // ============================================================================
  // Top-Level Configuration (inherited by environments unless overridden)
  // ============================================================================
  "name": "ki-jana-kb-explorer",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],

  // Environment Variables (NON-INHERITABLE - must repeat in each env)
  "vars": {
    "ENVIRONMENT": "production"
  },

  // ============================================================================
  // Environments
  // ============================================================================
  "env": {

    // Preview (deployed on Pull Requests)
    "preview": {
      "name": "ki-jana-kb-explorer-preview",
      "routes": [{ "pattern": "ki-jana-kb-explorer-preview.tob.sh", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "preview"
      }
    },

    // Staging (deployed on push to main)
    "staging": {
      "name": "ki-jana-kb-explorer-staging",
      "routes": [{ "pattern": "ki-jana-kb-explorer-staging.tob.sh", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },

    // Production (deployed on tag push v*)
    "production": {
      "name": "ki-jana-kb-explorer",
      "routes": [{ "pattern": "ki-jana-kb-explorer.tob.sh", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
